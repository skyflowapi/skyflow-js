    "jss-preset-default": "10.10.0",
    "jwt-decode": "3.1.2",
    "lodash": "4.17.21",
    "mime": "3.0.0",
    "regex-parser": "2.3.1",
    "set-value": "4.1.0"
  },
  "engines": {
    "node": ">=12.0",
    "npm": ">=6.0"
  }
